# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Find yours by messaging @userinfobot. Leave empty to (DANGEROUSLY) allow everyone.
ALLOWED_TELEGRAM_IDS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: Google Maps Platform key for Places, Routes, Static Maps, and Weather.
# Enable Places API (New), Routes API, Maps Static API, and Weather API as needed.
# Restrict the key in Google Cloud and set a budget alert.
GOOGLE_MAPS_API_KEY=

# Optional: Aviation Stack key for flight enrichment (airports, schedule, gates).
AVIATIONSTACK_API_KEY=

# Optional: Gmail OAuth (per-user email search). Enable Gmail API in Google Cloud.
# Create an OAuth 2.0 Web client; redirect URI must match GOOGLE_OAUTH_REDIRECT_URI.
# OAUTH_TOKEN_ENCRYPTION_KEY: 32 bytes as 64-char hex (openssl rand -hex 32).
# PUBLIC_APP_URL: HTTPS base URL (same domain as nginx). OAuth is proxied at /trip-planner/oauth/.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/trip-planner/oauth/google/callback
OAUTH_TOKEN_ENCRYPTION_KEY=
PUBLIC_APP_URL=https://your-domain.example
HTTP_PORT=3000

# Postgres connection. Defaults match docker-compose.yml.
# Prisma and the app both read DATABASE_URL. When the bot runs natively
# (systemd / local dev) it connects to the Docker container via localhost.
DATABASE_URL=postgresql://trip:trip@localhost:5432/tripplanner?schema=public

# Postgres container credentials (consumed by docker-compose.yml).
POSTGRES_USER=trip
POSTGRES_PASSWORD=trip
POSTGRES_DB=tripplanner
POSTGRES_PORT=5432

# Directory for generated exports (PDF/CSV) and other app files.
DATA_DIR=./data/exports

# Optional: AWS S3 bucket for cached exports (itinerary PDF/CSV, Gmail PDFs, route map PNGs).
# When unset, exports are written locally under DATA_DIR without cross-request caching.
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EXPORT_CACHE_MAX_AGE_DAYS=30
EXPORT_BUCKET_MAX_BYTES=4294967296
EXPORT_RETENTION_INTERVAL_MS=86400000

# Max time (ms) for processing one Telegram update before Telegraf times out. Default 180000 (3 min).
BOT_HANDLER_TIMEOUT_MS=180000

# System Chromium binary for Gmail PDF export (Debian default: /usr/bin/chromium).
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: server SSH/sudo password for scripts/deploy.sh (local dev machine only).
# Requires sshpass locally. When unset, deploy prompts for passwords interactively.
# DEPLOY_PASSWORD=
